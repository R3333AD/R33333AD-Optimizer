<Window x:Class="FPSBooster.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:FPSBooster.App.Services"
        Title="R33333AD Optimizer" Width="1240" Height="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Opacity="0">
  <Window.Triggers>
    <EventTrigger RoutedEvent="Loaded">
      <BeginStoryboard>
        <Storyboard>
          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45"/>
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>

  <Border x:Name="OuterBorder" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1" CornerRadius="14" ClipToBounds="True">
    <Grid>
      <!-- FOND PHOTO/VIDÉO (assombri pour rester lisible) -->
      <Image x:Name="BgImage" Stretch="UniformToFill" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Image.RenderTransform>
          <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Image.RenderTransform>
      </Image>
      <MediaElement x:Name="BgVideo" Stretch="UniformToFill" Opacity="0" Visibility="Collapsed"
                    LoadedBehavior="Manual" UnloadedBehavior="Manual" IsMuted="True"/>
      <Border x:Name="BgOverlay" Background="Black" Opacity="0"/>
      <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- TITLEBAR CUSTOM -->
      <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
        <Grid Margin="16,0,12,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="#3A3A3F" Margin="0,0,8,0"/>
            <TextBlock Text="R33333AD Optimizer" Foreground="#D4D4D8" FontSize="13" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="?" Width="32" Height="28" Background="Transparent" Foreground="#A1A1AA"
                    BorderThickness="0" Cursor="Hand" Click="Help_Click" ToolTip="Aide / Help"/>
            <Button Content="—" Width="32" Height="28" Background="Transparent" Foreground="#A1A1AA"
                    BorderThickness="0" Cursor="Hand" Click="Min_Click"/>
            <Button x:Name="MaxBtn" Content="☐" Width="32" Height="28" Background="Transparent" Foreground="#A1A1AA"
                    BorderThickness="0" Cursor="Hand" Click="Max_Click"/>
            <Button Content="✕" Width="32" Height="28" Background="Transparent" Foreground="#A1A1AA"
                    BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="240"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ SIDEBAR ============ -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,0" CornerRadius="0,0,0,14">
          <Grid Margin="14">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="6,6,0,14">
              <TextBlock Text="R33333AD" Foreground="White" FontSize="20" FontWeight="ExtraBold"/>
              <TextBlock Text="O P T I M I Z E R" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- NAV : liée aux sections du ViewModel -->
            <ItemsControl Grid.Row="1" x:Name="NavList" ItemsSource="{Binding Sections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Click="Nav_Click" Cursor="Hand" Margin="0,0,0,2" HorizontalContentAlignment="Stretch" BorderThickness="0">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="#38FFFFFF"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="26" Height="26" CornerRadius="8" Margin="0,0,10,0">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#1C1C21"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="#1C1C21"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="#A1A1AA"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                  <Setter Property="Foreground" Value="#C8FF2E"/>
                                  <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#A1A1AA"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- STATS BAS -->
            <StackPanel Grid.Row="2">
              <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                <StackPanel>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                      <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                          <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.8"/>
                            </Storyboard>
                          </BeginStoryboard>
                        </EventTrigger>
                      </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="CPU" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="6,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding Cpu, StringFormat={}{0:0}%}" Foreground="White" FontSize="11"/>
                  </Grid>
                  <Border Height="4" Background="#26262B" CornerRadius="2" Margin="0,0,0,6">
                    <Border x:Name="CpuBar" Background="{DynamicResource AccentBrush}" CornerRadius="2" HorizontalAlignment="Left" Width="20"/>
                  </Border>
                  <Grid Margin="0,0,0,4">
                    <TextBlock Text="RAM" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding Ram, StringFormat={}{0:0}%}" Foreground="White" FontSize="11" HorizontalAlignment="Right"/>
                  </Grid>
                  <Border Height="4" Background="#26262B" CornerRadius="2" Margin="0,0,0,6">
                    <Border x:Name="RamBar" Background="White" CornerRadius="2" HorizontalAlignment="Left" Width="100"/>
                  </Border>
                  <Grid Margin="0,0,0,4">
                    <TextBlock Text="GPU" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding Gpu}" Foreground="White" FontSize="11" HorizontalAlignment="Right"/>
                  </Grid>
                  <Grid>
                    <TextBlock Text="{Binding [Stats_Executed], Source={x:Static svc:Loc.Instance}}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding Executed}" Foreground="White" FontSize="11" HorizontalAlignment="Right"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="4" Margin="0,10,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <Button x:Name="LangFrBtn" Content="FR" Tag="fr" Click="Lang_Click" Cursor="Hand"
                          FontSize="11" FontWeight="Bold" BorderThickness="0" Background="Transparent" Foreground="#52525B" Padding="0,6">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="0,6">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                  <Button x:Name="LangArBtn" Grid.Column="1" Content="AR" Tag="ar" Click="Lang_Click" Cursor="Hand"
                          FontSize="11" FontWeight="Bold" BorderThickness="0" Background="Transparent" Foreground="#52525B" Padding="0,6">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="0,6">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                  <Button x:Name="LangEnBtn" Grid.Column="2" Content="EN" Tag="en" Click="Lang_Click" Cursor="Hand"
                          FontSize="11" FontWeight="Bold" BorderThickness="0" Background="Transparent" Foreground="#52525B" Padding="0,6">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="0,6">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                  <Button x:Name="ThemeBtn" Grid.Column="3" Content="☾" Click="ThemeToggle_Click" Cursor="Hand"
                          FontSize="11" FontWeight="Bold" BorderThickness="0" Background="Transparent" Foreground="#52525B" Padding="0,6" Tag="dark"/>
                </Grid>
              </Border>
              <CheckBox x:Name="AutoStartCheck" Content="▶ Windows" Foreground="#A1A1AA" FontSize="11"
                        Margin="6,10,0,0" VerticalAlignment="Center"
                        ToolTip="{Binding [Startup_Tip], Source={x:Static svc:Loc.Instance}}"
                        Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ============ MAIN ============ -->
        <Grid x:Name="MainContent" Grid.Column="1" Margin="28,10,28,18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Text="{Binding SelectedSection.Header}" Foreground="#52525B" FontSize="11" Margin="2,0,0,6"/>

          <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding SelectedSection.Title}" Foreground="White" FontSize="32" FontWeight="ExtraBold"/>
              <TextBlock Text="{Binding ToolsSubtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel x:Name="ToolsHeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4" Height="36" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="Risk0Btn" Tag="0" Click="Risk_Click" Cursor="Hand" FontSize="11" FontWeight="Bold"
                          Content="{Binding [Risk_0], Source={x:Static svc:Loc.Instance}}"
                          BorderThickness="0" Background="Transparent" Foreground="#52525B" Padding="10,0">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="10,5">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                  <Button x:Name="Risk1Btn" Tag="1" Click="Risk_Click" Cursor="Hand" FontSize="11" FontWeight="Bold"
                          Content="{Binding [Risk_1], Source={x:Static svc:Loc.Instance}}"
                          BorderThickness="0" Background="Transparent" Foreground="#52525B" Padding="10,0">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="10,5">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                  <Button x:Name="Risk2Btn" Tag="2" Click="Risk_Click" Cursor="Hand" FontSize="11" FontWeight="Bold"
                          Content="{Binding [Risk_2], Source={x:Static svc:Loc.Instance}}"
                          BorderThickness="0" Background="Transparent" Foreground="#52525B" Padding="10,0">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="10,5">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,0" Height="36" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="⌕" Foreground="#52525B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBox x:Name="SearchBox" Width="150" Background="Transparent" BorderThickness="0"
                           Foreground="White" CaretBrush="White" VerticalContentAlignment="Center"
                           Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                           TextChanged="SearchBox_TextChanged"/>
                </StackPanel>
              </Border>
              <Button x:Name="SortGainBtn" Content="⇅ %" Height="36" Padding="14,0" FontWeight="SemiBold" Margin="0,0,10,0"
                      Foreground="White" Background="{DynamicResource BtnBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Cursor="Hand" Click="SortGain_Click"
                      ToolTip="{Binding [Gain_SortTip], Source={x:Static svc:Loc.Instance}}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <Button x:Name="RevertBtn" Content="↩ Annuler" Height="36" Padding="16,0" FontWeight="SemiBold" Margin="0,0,10,0"
                      Foreground="White" Background="{DynamicResource BtnBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Cursor="Hand" Click="Revert_Click">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <Button x:Name="JournalBtn" Content="{Binding [Journal_Btn], Source={x:Static svc:Loc.Instance}}" Height="36" Padding="14,0" FontWeight="SemiBold" Margin="0,0,10,0"
                      Foreground="White" Background="{DynamicResource BtnBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Cursor="Hand" Click="Journal_Click">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <Button x:Name="BoostAllBtn" Content="⚡ BOOST ALL" Height="36" Padding="18,0" FontWeight="Bold"
                      Foreground="Black" Background="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand" Click="BoostAll_Click">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
                <Button.Effect>
                  <DropShadowEffect Color="#C8FF2E" Opacity="0.35" BlurRadius="14" ShadowDepth="0"/>
                </Button.Effect>
                <Button.RenderTransformOrigin>0.5,0.5</Button.RenderTransformOrigin>
                <Button.RenderTransform><ScaleTransform/></Button.RenderTransform>
                <Button.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.05" Duration="0:0:0.9"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="1" To="1.05" Duration="0:0:0.9"/>
                        <DoubleAnimation Storyboard.TargetProperty="(Button.Effect).(DropShadowEffect.Opacity)" From="0.2" To="0.65" Duration="0:0:0.9"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Button.Triggers>
              </Button>
            </StackPanel>
          </Grid>

          <!-- DASHBOARD HOME -->
          <StackPanel x:Name="HomePanel" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
            <UniformGrid Columns="3">
              <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20,16" Margin="0,0,12,0">
                <StackPanel>
                  <TextBlock Text="{Binding [Home_Applied], Source={x:Static svc:Loc.Instance}}" Foreground="#52525B" FontSize="11"/>
                  <TextBlock Foreground="White" FontSize="30" FontWeight="ExtraBold" Margin="0,4,0,0">
                    <Run Text="{Binding Executed, Mode=OneWay}"/><Run Text=" / " Foreground="#52525B"/><Run Text="{Binding Tools.Count, Mode=OneWay}" Foreground="#52525B"/>
                  </TextBlock>
                  <TextBlock Text="{Binding [Home_AppliedSub], Source={x:Static svc:Loc.Instance}}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20,16" Margin="0,0,12,0">
                <StackPanel>
                  <TextBlock Text="CPU" Foreground="#52525B" FontSize="11"/>
                  <TextBlock Text="{Binding Cpu, StringFormat={}{0:0}%}" Foreground="{DynamicResource AccentBrush}" FontSize="30" FontWeight="ExtraBold" Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding [Home_CpuSub], Source={x:Static svc:Loc.Instance}}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20,16">
                <StackPanel>
                  <TextBlock Text="RAM" Foreground="#52525B" FontSize="11"/>
                  <TextBlock Text="{Binding Ram, StringFormat={}{0:0}%}" Foreground="White" FontSize="30" FontWeight="ExtraBold" Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding [Home_RamSub], Source={x:Static svc:Loc.Instance}}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                </StackPanel>
              </Border>
            </UniformGrid>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button Content="{Binding [Home_Boost1], Source={x:Static svc:Loc.Instance}}" Tag="boost1" Click="HomeQuick_Click" Margin="0,0,10,0"
                      Foreground="Black" Background="{DynamicResource AccentBrush}" FontWeight="Bold"
                      Height="40" Padding="20,0" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <Button Content="{Binding [Home_Clean], Source={x:Static svc:Loc.Instance}}" Tag="clean_temp" Click="HomeQuick_Click" Margin="0,0,10,0"
                      Foreground="White" Background="{DynamicResource BtnBrush}" FontWeight="SemiBold"
                      Height="40" Padding="20,0" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <Button Content="{Binding [Home_Restore], Source={x:Static svc:Loc.Instance}}" Tag="restore_point" Click="HomeQuick_Click"
                      Foreground="White" Background="{DynamicResource BtnBrush}" FontWeight="SemiBold" Margin="0,0,10,0"
                      Height="40" Padding="20,0" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <Button Content="{Binding [Home_Overlay], Source={x:Static svc:Loc.Instance}}" Click="OverlayToggle_Click" Margin="0,0,10,0"
                      Foreground="White" Background="{DynamicResource BtnBrush}" FontWeight="SemiBold"
                      Height="40" Padding="20,0" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0" ToolTip="Intensité du fond">
                <TextBlock Text="◐" Foreground="#52525B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Slider x:Name="BgOpacitySlider" Width="110" Minimum="5" Maximum="60" Value="35"
                        VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"
                        ValueChanged="BgOpacity_Changed"/>
              </StackPanel>
            </StackPanel>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20,16" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="{Binding [Bench_Hist], Source={x:Static svc:Loc.Instance}}" Foreground="#52525B" FontSize="11"/>
                <Polyline x:Name="BenchSpark" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Height="40" Margin="0,8,0,4" Stretch="Fill"/>
                <ItemsControl x:Name="BenchHistList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="2,14,0,0" VerticalAlignment="Center">
              <CheckBox x:Name="SchedCheck" Content="{Binding [Sched_Auto], Source={x:Static svc:Loc.Instance}}" Foreground="White"
                        VerticalAlignment="Center" Margin="0,0,10,0" Checked="SchedCheck_Changed" Unchecked="SchedCheck_Changed"
                        ToolTip="{Binding [Sched_Tip], Source={x:Static svc:Loc.Instance}}"/>
              <ComboBox x:Name="SchedAction" Width="170" Height="30" Margin="0,0,10,0" VerticalAlignment="Center"
                        Background="#1E1E24" Foreground="White" SelectionChanged="SchedAction_Changed">
                <ComboBox.Template>
                  <ControlTemplate TargetType="ComboBox">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Border Grid.ColumnSpan="2" Background="{TemplateBinding Background}"
                              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"/>
                      <ContentPresenter Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        TextElement.Foreground="White" IsHitTestVisible="False"/>
                      <ToggleButton Grid.Column="1" Width="26" Background="Transparent" BorderThickness="0"
                                    Foreground="White" Focusable="False" ClickMode="Press" Cursor="Hand"
                                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                        <TextBlock Text="▼" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </ToggleButton>
                      <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                             IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                             MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                        <Border Background="#1E1E24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                          <ScrollViewer>
                            <ItemsPresenter/>
                          </ScrollViewer>
                        </Border>
                      </Popup>
                    </Grid>
                  </ControlTemplate>
                </ComboBox.Template>
                <ComboBox.ItemContainerStyle>
                  <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="#1E1E24"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Style.Triggers>
                      <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="#3A3A42"/>
                        <Setter Property="Foreground" Value="White"/>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </ComboBox.ItemContainerStyle>
              </ComboBox>
              <TextBox x:Name="SchedTime" Width="60" Height="30" Background="{DynamicResource PanelBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                       Foreground="White" CaretBrush="White" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                       Padding="0,6" ToolTip="HH:mm" TextChanged="SchedTime_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="2,10,0,0" VerticalAlignment="Center">
              <CheckBox x:Name="UpdateAutoCheck" Content="{Binding [Update_Auto], Source={x:Static svc:Loc.Instance}}" Foreground="White"
                        VerticalAlignment="Center" Margin="0,0,10,0" Checked="UpdateAuto_Changed" Unchecked="UpdateAuto_Changed"/>
              <TextBox x:Name="UpdateUrlBox" Width="280" Height="30" Background="{DynamicResource PanelBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                       Foreground="White" CaretBrush="White" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,10,0"
                       ToolTip="{Binding [Update_UrlTip], Source={x:Static svc:Loc.Instance}}" TextChanged="UpdateUrl_Changed"/>
              <Button Content="{Binding [Update_Check], Source={x:Static svc:Loc.Instance}}" Height="30" Padding="14,0" FontWeight="SemiBold"
                      Foreground="White" Background="{DynamicResource BtnBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Cursor="Hand" Click="UpdateCheck_Click">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </StackPanel>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20,16" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="{Binding [Disk_Title], Source={x:Static svc:Loc.Instance}}" Foreground="#52525B" FontSize="11"/>
                <ItemsControl x:Name="DiskList" Margin="0,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Icon}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Width="20" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Health}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="2,12,0,0"/>
          </StackPanel>

          <!-- PANNEAU DÉSINSTALLEUR -->
          <Grid x:Name="UninstallerPanel" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,0" Height="36" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="⌕" Foreground="#52525B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBox x:Name="AppSearchBox" Width="220" Background="Transparent" BorderThickness="0"
                           Foreground="White" CaretBrush="White" VerticalContentAlignment="Center"
                           Text="{Binding AppSearch, UpdateSourceTrigger=PropertyChanged}"
                           TextChanged="AppSearchBox_TextChanged"/>
                </StackPanel>
              </Border>
              <Button Grid.Column="1" Content="{Binding [Un_Refresh], Source={x:Static svc:Loc.Instance}}" Height="36" Padding="16,0" Click="RefreshApps_Click"
                      Foreground="White" Background="{DynamicResource BtnBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
              <ListView x:Name="AppsList" ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}"
                        Background="Transparent" BorderThickness="0" Foreground="White"
                        GridViewColumnHeader.Click="SortApps_Click">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                          <Border x:Name="Bd" Background="Transparent" Padding="2,1">
                            <GridViewRowPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="#662E2E35"/>
                              <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="#331E1E24"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.Resources>
                  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2E2E35"/>
                  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#232329"/>
                  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                  <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Background" Value="#991E1E24"/>
                    <Setter Property="Foreground" Value="#8E8E93"/>
                    <Setter Property="BorderBrush" Value="#232329"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="Padding" Value="8,6"/>
                  </Style>
                </ListView.Resources>
                <ListView.View>
                  <GridView>
                    <GridViewColumn Header="⧉" Width="36">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate>
                          <CheckBox Tag="{Binding}" Checked="QueueCheck_Changed" Unchecked="QueueCheck_Changed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{Binding [Un_ColName], Source={x:Static svc:Loc.Instance}}" Width="300" DisplayMemberBinding="{Binding DisplayName}"/>
                    <GridViewColumn Header="{Binding [Un_ColVer], Source={x:Static svc:Loc.Instance}}" Width="110" DisplayMemberBinding="{Binding Version}"/>
                    <GridViewColumn Header="{Binding [Un_ColPub], Source={x:Static svc:Loc.Instance}}" Width="210" DisplayMemberBinding="{Binding Publisher}"/>
                    <GridViewColumn Header="{Binding [Un_ColSize], Source={x:Static svc:Loc.Instance}}" Width="80" DisplayMemberBinding="{Binding DisplaySize}"/>
                  </GridView>
                </ListView.View>
              </ListView>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="UninstallBtn" Content="{Binding [Un_Uninstall], Source={x:Static svc:Loc.Instance}}" Height="40" Padding="20,0" FontWeight="Bold"
                      Foreground="Black" Background="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand" Click="Uninstall_Click" Margin="0,0,10,0">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <Button x:Name="QueueBtn" Content="🗑 File (0)" Height="40" Padding="20,0" FontWeight="SemiBold" Margin="0,0,10,0"
                      Foreground="White" Background="{DynamicResource BtnBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Cursor="Hand" Click="UninstallQueue_Click" IsEnabled="False">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <TextBlock x:Name="UninstStatus" Text="{Binding [Un_PickFirst], Source={x:Static svc:Loc.Instance}}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="500"/>
            </StackPanel>

            <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,10,0,0">
              <StackPanel>
                <Grid>
                  <TextBlock Text="{Binding [Un_Leftovers], Source={x:Static svc:Loc.Instance}}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                  <Button Content="{Binding [Un_DeleteLeft], Source={x:Static svc:Loc.Instance}}" HorizontalAlignment="Right" Padding="14,6" FontSize="11" FontWeight="Bold"
                          Foreground="Black" Background="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand" Click="DeleteLeftovers_Click">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </Grid>
                <ListBox x:Name="LeftoversList" ItemsSource="{Binding Leftovers}" Background="Transparent" BorderThickness="0"
                         MaxHeight="110" Margin="0,6,0,0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Width="70" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Display}" Foreground="#D4D4D8" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="640"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
          </Grid>

          <ScrollViewer x:Name="ToolsScroll" Grid.Row="2" VerticalScrollBarVisibility="Hidden" Margin="0,10,0,0">
            <ItemsControl x:Name="ToolsList" ItemsSource="{Binding Tools}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ToolCardStyle}" Tag="ToolCard" Margin="0,0,12,12"
                          MouseLeftButtonUp="Card_Click">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                          <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Style>
                              <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#3F3F46"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                    <Setter Property="Fill" Value="#C8FF2E"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Ellipse.Style>
                          </Ellipse>
                          <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13.5" FontWeight="SemiBold"
                                     TextWrapping="Wrap" MaxWidth="190"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{Binding GainText}" Foreground="{Binding GainBrush}" FontSize="11" FontWeight="Bold"
                                     VerticalAlignment="Center" ToolTip="{Binding [Gain_Tip], Source={x:Static svc:Loc.Instance}}"/>
                          <Button Content="📏" Click="MeasureGain_Click" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                  Foreground="#71717A" FontSize="11" Padding="8,0,0,0" VerticalAlignment="Center"
                                  ToolTip="{Binding [Gain_MeasureTip], Source={x:Static svc:Loc.Instance}}"/>
                        </StackPanel>
                      </StackPanel>
                      <Border Grid.Column="1" Style="{StaticResource BadgeStyle}" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Badge}" Foreground="#71717A" FontSize="10" FontWeight="Bold"/>
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- TOAST + PROGRESS -->
          <Grid Grid.Row="3" Margin="0,8,0,0">
            <Border x:Name="Toast" Background="#E61A1A1F" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="14,10" Opacity="0" HorizontalAlignment="Left">
              <Border.RenderTransform>
                <TranslateTransform X="60"/>
              </Border.RenderTransform>
              <TextBlock x:Name="ToastText" Text="✓ Optimisation appliquée" Foreground="White" FontSize="12" TextWrapping="Wrap" MaxWidth="620"/>
            </Border>
            <ProgressBar x:Name="RunProgress" Height="4" Minimum="0" Maximum="100" Value="0"
                         Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="0,0,0,-8"/>
          </Grid>
        </Grid>
      </Grid>
      <!-- PASTILLE MISE À JOUR (flottante, animée) -->
      <Border x:Name="UpdatePill" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,10,28,0" Visibility="Collapsed" Panel.ZIndex="50" Cursor="Hand" Opacity="0"
              Background="#E61A1A1F" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
              CornerRadius="12" Padding="14,10" MouseLeftButtonUp="UpdatePill_Click">
        <Border.Resources>
          <Storyboard x:Key="PillEnter">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="60" To="0" Duration="0:0:0.35">
              <DoubleAnimation.EasingFunction>
                <QuadraticEase EasingMode="EaseOut"/>
              </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
          </Storyboard>
          <Storyboard x:Key="PillPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)" From="0.25" To="0.7" Duration="0:0:0.9"/>
          </Storyboard>
        </Border.Resources>
        <Border.RenderTransform>
          <TranslateTransform X="60"/>
        </Border.RenderTransform>
        <Border.Effect>
          <DropShadowEffect Color="{DynamicResource AccentColor}" Opacity="0.35" BlurRadius="14" ShadowDepth="0"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="⬆" Foreground="{DynamicResource AccentBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PillVersionText" Text="Nouvelle version" Foreground="White" FontSize="12" FontWeight="Bold"/>
            <TextBlock Text="{Binding [Update_PillSub], Source={x:Static svc:Loc.Instance}}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
          </StackPanel>
          <Button Content="✕" Background="Transparent" Foreground="#71717A" BorderThickness="0" Cursor="Hand"
                  FontSize="10" Padding="10,0,0,0" VerticalAlignment="Center" Click="UpdatePill_Dismiss"/>
        </StackPanel>
      </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
