<Window x:Class="FPSBooster.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="R33333AD HUD" Width="350" Height="92"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Left="1660" Top="30" Opacity="0"
        KeyDown="Overlay_KeyDown">
  <Window.Triggers>
    <EventTrigger RoutedEvent="Loaded">
      <BeginStoryboard>
        <Storyboard>
          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>
  <!-- Minimaliste : juste chiffres + noms, ombre portée pour lisibilité en jeu -->
  <Grid Background="Transparent" MouseLeftButtonDown="Root_MouseDown">
    <Grid.Effect>
      <DropShadowEffect Color="Black" Opacity="0.9" BlurRadius="4" ShadowDepth="1"/>
    </Grid.Effect>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <UniformGrid Columns="5">
      <StackPanel Margin="0,0,10,0">
        <TextBlock Text="CPU" Foreground="#A1A1AA" FontSize="9" FontWeight="Bold"/>
        <TextBlock x:Name="CpuText" Text="—" Foreground="White" FontSize="15" FontWeight="ExtraBold"/>
      </StackPanel>
      <StackPanel Margin="0,0,10,0">
        <TextBlock Text="RAM" Foreground="#A1A1AA" FontSize="9" FontWeight="Bold"/>
        <TextBlock x:Name="RamText" Text="—" Foreground="White" FontSize="15" FontWeight="ExtraBold"/>
      </StackPanel>
      <StackPanel Margin="0,0,10,0">
        <TextBlock Text="GPU" Foreground="#A1A1AA" FontSize="9" FontWeight="Bold"/>
        <TextBlock x:Name="GpuText" Text="—" Foreground="White" FontSize="15" FontWeight="ExtraBold"/>
      </StackPanel>
      <StackPanel Margin="0,0,10,0">
        <TextBlock Text="FPS" Foreground="#A1A1AA" FontSize="9" FontWeight="Bold"/>
        <TextBlock x:Name="FpsText" Text="—" Foreground="White" FontSize="15" FontWeight="ExtraBold"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="PING" Foreground="#A1A1AA" FontSize="9" FontWeight="Bold"/>
        <TextBlock x:Name="PingText" Text="—" Foreground="#C8FF2E" FontSize="15" FontWeight="ExtraBold"/>
      </StackPanel>
    </UniformGrid>
    <TextBlock Grid.Row="1" x:Name="GameText" Text="" Foreground="#D4D4D8" FontSize="10" Margin="0,2,0,0"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0" Opacity="0.75">
      <CheckBox x:Name="ClickThroughBox" Content="Clics à travers" Foreground="#71717A" FontSize="9"
                VerticalContentAlignment="Center" Checked="ClickThrough_Changed" Unchecked="ClickThrough_Changed"/>
      <Button Content="✕" Background="Transparent" Foreground="#71717A" BorderThickness="0"
              Cursor="Hand" Click="Close_Click" FontSize="9" Padding="8,0,0,0"/>
    </StackPanel>
  </Grid>
</Window>
