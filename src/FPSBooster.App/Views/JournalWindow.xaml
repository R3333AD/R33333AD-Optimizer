<Window x:Class="FPSBooster.App.Views.JournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:FPSBooster.App.Services"
        Title="Journal" Width="880" Height="560"
        Background="#09090B" WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#141417" BorderBrush="#232329" BorderThickness="1" CornerRadius="10">
      <ListView x:Name="EntriesList" Background="Transparent" BorderThickness="0" Foreground="#D4D4D8"
               FontFamily="Consolas" FontSize="11">
        <ListView.Resources>
          <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2E2E35"/>
          <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
          <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#991E1E24"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="BorderBrush" Value="#232329"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
          </Style>
        </ListView.Resources>
        <ListView.View>
          <GridView>
            <GridViewColumn Header="{Binding [Journal_ColWhen], Source={x:Static svc:Loc.Instance}}" Width="150" DisplayMemberBinding="{Binding When}"/>
            <GridViewColumn Header="{Binding [Journal_ColAction], Source={x:Static svc:Loc.Instance}}" Width="210" DisplayMemberBinding="{Binding Action}"/>
            <GridViewColumn Header="{Binding [Journal_ColDetail], Source={x:Static svc:Loc.Instance}}" Width="400" DisplayMemberBinding="{Binding Detail}"/>
            <GridViewColumn Width="52">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="↩" Padding="10,2" Cursor="Hand" Tag="{Binding E}" Click="RevertOne_Click"
                          Background="#C8FF2E" Foreground="Black" FontWeight="Bold" BorderThickness="0"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
    </Border>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
      <Button Content="↻" Click="Refresh_Click" Padding="18,8"
              Foreground="White" Background="#1C1C21" BorderThickness="1" BorderBrush="#232329" Cursor="Hand"/>
      <TextBlock x:Name="JournalStatus" Text="" Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
    </StackPanel>
  </Grid>
</Window>
