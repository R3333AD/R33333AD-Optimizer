<Window x:Class="FPSBooster.App.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="R33333AD — Logs" Width="760" Height="520"
        Background="#09090B" WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
      <Button x:Name="FilterAllBtn" Content="Tous" Click="Filter_Click" Tag="" Margin="0,0,8,0"
              Foreground="Black" Background="#C8FF2E" FontWeight="Bold" Padding="16,6" BorderThickness="0" Cursor="Hand"/>
      <Button x:Name="FilterErrBtn" Content="Erreurs" Click="Filter_Click" Tag="ERROR" Margin="0,0,8,0"
              Foreground="White" Background="#1C1C21" Padding="16,6" BorderThickness="1" BorderBrush="#232329" Cursor="Hand"/>
      <Button x:Name="FilterWarnBtn" Content="Averts" Click="Filter_Click" Tag="WARN" Margin="0,0,8,0"
              Foreground="White" Background="#1C1C21" Padding="16,6" BorderThickness="1" BorderBrush="#232329" Cursor="Hand"/>
      <TextBlock x:Name="LogCount" Text="" Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#141417" BorderBrush="#232329" BorderThickness="1" CornerRadius="10">
      <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" Foreground="#D4D4D8"
               FontFamily="Consolas" FontSize="11"/>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
      <Button Content="📤 Exporter (Bureau)" Click="Export_Click" Margin="0,0,10,0"
              Foreground="Black" Background="#C8FF2E" FontWeight="Bold" Padding="18,8" BorderThickness="0" Cursor="Hand"/>
      <Button Content="↻ Actualiser" Click="Refresh_Click"
              Foreground="White" Background="#1C1C21" Padding="18,8" BorderThickness="1" BorderBrush="#232329" Cursor="Hand"/>
    </StackPanel>
  </Grid>
</Window>
